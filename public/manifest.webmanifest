{
  "id": "/",
  "name": "GameDataHub",
  "short_name": "GameDataHub",
  "description": "Discover games, track prices and your library, find teammates and get alerts for free games, deals and releases.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0a0b0f",
  "theme_color": "#0a0b0f",
  "lang": "en",
  "dir": "ltr",
  "categories": ["games", "entertainment", "social"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Free games", "short_name": "Free", "url": "/free-games?source=shortcut", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "My library", "short_name": "Library", "url": "/library?source=shortcut", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Find teammates", "short_name": "LFG", "url": "/lfg?source=shortcut", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Notifications", "short_name": "Alerts", "url": "/notifications?source=shortcut", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
